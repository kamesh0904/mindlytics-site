{
  "name": "mindlytics-site",
  "version": "1.0.0",
  "private": true,
  "description": "Mindlytics marketing site. Static HTML generated from src/content.js.",
  "scripts": {
    "html": "node build.js",
    "assets": "node copy-assets.js",
    "css": "tailwindcss -i ./src/input.css -o ./dist/assets/css/site.css --minify",
    "stamp": "node stamp-assets.js",
    "build": "npm run html && npm run assets && npm run css && npm run stamp",
    "watch": "npm run build && tailwindcss -i ./src/input.css -o ./dist/assets/css/site.css --watch",
    "serve": "npx --yes serve dist -l 5173"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}
